{
  "name": "chromium-bridge",
  "version": "0.6.7",
  "description": "Local agent bridge for authenticated Chromium browsers, with a Codex plugin and optional Arc Spaces support.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "chromium-bridge": "./native-host/src/cli.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "setup": "node scripts/setup.mjs",
    "dev:link": "node scripts/dev.mjs link",
    "dev:status": "node scripts/dev.mjs status",
    "dev:unlink": "node scripts/dev.mjs unlink",
    "uninstall": "node scripts/uninstall.mjs",
    "install-host": "node native-host/src/install.mjs",
    "uninstall-host": "node native-host/src/install.mjs --uninstall",
    "bridge": "node native-host/src/cli.mjs",
    "test": "npm run check && node --test extension/*.test.mjs scripts/*.test.mjs && npm --prefix native-host test && npm --prefix plugins/chromium-bridge test && node scripts/setup.mjs --dry-run --no-codex --no-open",
    "package:extension": "node scripts/package-extension.mjs",
    "package:store": "node scripts/package-extension.mjs --store",
    "package:source": "node scripts/package-source.mjs",
    "configure:store": "node scripts/configure-store.mjs"
  }
}
