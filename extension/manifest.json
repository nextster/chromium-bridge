{
  "manifest_version": 3,
  "name": "Chromium Sidecar",
  "version": "0.4.0",
  "minimum_chrome_version": "135",
  "description": "Local agent bridge for Chromium tabs, page scripts, screenshots, cookies, and network capture.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chromium Sidecar"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "debugger",
    "nativeMessaging",
    "storage",
    "tabs",
    "userScripts",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
